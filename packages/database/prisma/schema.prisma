// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String?
  phone            String?
  password         String?
  authProvider     String          @default("LOCAL")
  role             String          @default("CUSTOMER")
  branch           String?         @default("Tagoloan")
  image            String?
  gender           String?
  dateOfBirth      String?
  status           String          @default("Active")
  suspendedUntil   DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  reviews          Review[]
  purchases        Purchase[]
  repairRequests   RepairRequest[]
  cartItems        CartItem[]
  notifications    Notification[]
  customerQuestions CustomerQuestion[]
  questionReplies   CustomerQuestionReply[]

  @@index([name])
  @@index([branch])
  @@index([role, branch])
}

model Device {
  id               String            @id @default(cuid())
  name             String
  price            Float
  cost             Float             @default(0)
  stock            Int
  sold             Int               @default(0)
  specs            String?
  image            String?
  images           String[]          @default([])
  downpaymentImage String?
  asLowAs          String?
  warranty         String?
  downpayment      String?
  type             String?
  discount         Float             @default(0)
  discountStartDate DateTime?
  discountEndDate   DateTime?
  branch           String            @default("Tagoloan")
  isPreOwned       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reviews          Review[]
  purchases        Purchase[]
  variations       DeviceVariation[]
  cartItems        CartItem[]
  branchStocks     BranchStock[]
  deviceUnits      DeviceUnit[]
  stockMovements   StockMovement[]

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([type])
  @@index([branch])
  @@index([branch, createdAt])
}

model Review {
  id             String    @id @default(cuid())
  text           String
  adminReply     String?
  adminReplyBy   String?
  adminReplyRole String?
  adminReplyDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model DeviceVariation {
  id          String   @id @default(cuid())
  productId   String?
  type        String
  name        String
  price       Float
  cost        Float    @default(0)
  stock       Int      @default(0)
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  branchStocks BranchStock[]
  deviceUnits  DeviceUnit[]
  stockMovements StockMovement[]

  @@index([deviceId])
  @@index([productId])
}

model RepairRequest {
  id            String           @id @default(cuid())
  deviceName    String
  ownerName     String?          @default("")
  progress      String
  cause         String?
  technician    String?
  repairCost    String?
  downpayment   String?
  materials     String?
  branch        String           @default("Tagoloan")
  image         String?
  proofImage    String?
  repairHistory String?
  status        String           @default("Active")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  timeline      RepairTimeline[]

  @@index([userId])
  @@index([createdAt])
  @@index([branch])
  @@index([branch, status])
}

model TechnicianFeedback {
  id             String   @id @default(cuid())
  customerName   String
  technicianName String?
  feedbackText   String
  sentiment      String   @default("Positive")
  branch         String?  @default("Tagoloan")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([branch])
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  name      String?
  linkUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
}

model Policy {
  id        String   @id @default(cuid())
  type      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  device      Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  amount      Float   @default(0)
  quantity    Int     @default(1)
  variations  String?
  paymentType String  @default("Full")
  source      String  @default("Online")
  branch      String  @default("Tagoloan")
  status      String  @default("Active")

  downpaymentAmount Float?   @default(0)
  remainingBalance  Float?   @default(0)
  isSettled         Boolean  @default(true)

  referenceId     String? @unique
  paymentIntentId String? @unique
  paymentUrl      String?
  receiptUrl      String?
  imei            String? @unique

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([branch])
  @@index([branch, createdAt])
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  variations String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([deviceId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  branch    String?  @default("Tagoloan")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([branch])
}

model RepairTimeline {
  id              String        @id @default(cuid())
  repairRequestId String
  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  status          String
  description     String?
  createdAt       DateTime      @default(now())

  @@index([repairRequestId])
}

model Branch {
  id          String   @id @default(cuid())
  name        String   @unique
  address     String?
  phone       String?
  email       String?
  status      String   @default("Active")
  gcashName   String?  @default("GRAPHIX MANAGEMENT")
  gcashNumber String?  @default("0967 123 4567")
  gcashQrCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  description String
  details     String?
  branch      String?
  userId      String?
  userName    String?
  userRole    String?
  createdAt   DateTime @default(now())

  @@index([branch])
  @@index([action])
  @@index([createdAt])
}

model BranchStock {
  id          String           @id @default(cuid())
  branch      String           // "Tagoloan" | "Villanueva" | "Jasaan"
  stock       Int              @default(0)
  sold        Int              @default(0)
  deviceId    String
  device      Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  variationId String?
  variation   DeviceVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  productId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([deviceId, variationId, branch])
  @@index([branch])
  @@index([productId])
  @@index([deviceId])
  @@index([variationId])
}

model StockMovement {
  id            String           @id @default(cuid())
  type          String           // "RESTOCK" | "TRANSFER" | "ADJUSTMENT" | "SALE"
  deviceId      String?
  device        Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  variationId   String?
  variation     DeviceVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  productId     String?
  productName   String
  fromBranch    String?
  toBranch      String?
  branch        String
  quantity      Int
  previousStock Int
  newStock      Int
  notes         String?
  performedBy   String?
  userRole      String?
  createdAt     DateTime         @default(now())

  @@index([branch])
  @@index([type])
  @@index([createdAt])
  @@index([productId])
}

model DeviceUnit {
  id          String           @id @default(cuid())
  imei        String           @unique
  deviceId    String
  device      Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  variationId String?
  variation   DeviceVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  productId   String?
  branch      String           @default("Tagoloan")
  status      String           @default("Available") // "Available" | "Sold" | "Transferred"
  purchaseId  String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branch])
  @@index([status])
  @@index([deviceId])
  @@index([variationId])
  @@index([productId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model CustomerQuestion {
  id         String                  @id @default(cuid())
  questionId String                  @unique // e.g. QST-T26-A1 (internal only, never exposed in UI)
  customerId String
  customer   User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId   String?
  branchName String                  // e.g. "Tagoloan"
  subject    String
  question   String
  orderId    String?
  status     String                  @default("Pending") // "Pending" | "Answered" | "Closed"
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  replies    CustomerQuestionReply[]

  @@index([customerId])
  @@index([branchName])
  @@index([status])
  @@index([createdAt])
}

model CustomerQuestionReply {
  id         String           @id @default(cuid())
  questionId String
  question   CustomerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderName String
  senderRole String           // "CUSTOMER" | "ADMIN" | "SUPER_ADMIN"
  message    String
  createdAt  DateTime         @default(now())

  @@index([questionId])
  @@index([senderId])
  @@index([createdAt])
}

model QuestionSequence {
  id         String   @id @default(cuid())
  branchCode String   // "T", "V", "J"
  year       Int      // 2026, 2027
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([branchCode, year])
}

model BranchDocumentation {
  id         String   @id @default(cuid())
  branch     String   // "Tagoloan" | "Villanueva" | "Jasaan"
  branchId   String?
  uploadedBy String?
  photoUrl   String
  title      String?
  caption    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([branch])
  @@index([createdAt])
}


